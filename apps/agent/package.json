{
  "name": "@last-orders/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --conditions=source src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "bundle": "node bundle.mjs",
    "eval": "tsx --conditions=source evals/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@last-orders/engine": "0.1.0",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
